# Copy to .env.local for local development.

# Base URL of resurface-backend. Leave unset to use http://localhost:3001.
VITE_API_BASE=https://api.resurface.example

# Supabase. The publishable/anon key is designed to ship in the browser — it
# grants nothing on its own, because every table is behind RLS. Never put the
# service_role key here: VITE_ vars are inlined into the bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
