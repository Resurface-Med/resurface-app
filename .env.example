# Copy to .env.local for local dev with `vercel dev`.
# In production these live in Vercel project settings, not in this repo.

# Your Anthropic API key. Server-side only — never prefix with VITE_,
# or Vite will inline it into the browser bundle.
ANTHROPIC_API_KEY=sk-ant-...

# Shared access code your friends type once in Generate mode.
# Leave unset to disable the check (not recommended once deployed).
ASCEND_PASSCODE=change-me
